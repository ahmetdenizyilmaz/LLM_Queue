    "package": "node scripts/build.mjs && node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.30",
    "@types/node": "^22.15.3",
    "esbuild": "^0.25.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
